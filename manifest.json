{
  "manifest_version": 3,
  "name": "Rosewash",
  "version": "0.2.0",
  "description": "A lightweight Rose Pine tint for harsh white web pages.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rosewash"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "src/background/background.js"
  },
  "commands": {
    "toggle-current-site": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "Toggle blocked / allowed for the current site"
    },
    "open-pdf-locally": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Download the current PDF and open it in a local app"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "src/content/theme.css"
      ],
      "js": [
        "src/content/core.js",
        "src/content/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "css": [
        "src/sites/x.css"
      ],
      "js": [
        "src/sites/x-core.js",
        "src/sites/x.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://zhihu.com/*",
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*"
      ],
      "css": [
        "src/sites/zhihu.css"
      ],
      "js": [
        "src/sites/zhihu.js"
      ],
      "run_at": "document_start"
    }
  ]
}
