{
  "manifest_version": 3,
  "name": "Rosewash",
  "version": "0.2.5",
  "description": "A lightweight Rose Pine tint for harsh white web pages.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "fontSettings"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Rosewash"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "src/background/background.js"
  },
  "commands": {
    "toggle-current-site": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "Toggle Always on / Always off for the current site"
    },
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Pause or resume Rosewash on all sites"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "src/content/theme.css"
      ],
      "js": [
        "src/content/core.js",
        "src/content/content.js",
        "src/content/picker.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*"
      ],
      "css": [
        "src/sites/x.css"
      ],
      "js": [
        "src/sites/x.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://zhihu.com/*",
        "https://www.zhihu.com/*",
        "https://zhuanlan.zhihu.com/*"
      ],
      "css": [
        "src/sites/zhihu.css"
      ],
      "js": [
        "src/sites/zhihu.js"
      ],
      "run_at": "document_start"
    }
  ]
}
